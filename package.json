{
  "name": "@prkit/vue",
  "title": "PrKit Vue",
  "description": "A Vue 3 component library built on top of PrKit Core.",
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rtl": "set rtl=true&& vite --config vite.config.js",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check",
    "lint:oxlint:check": "oxlint .",
    "lint:eslint:check": "eslint . --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getprkit/vue.git"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "prkit": "github:getprkit/core#develop",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@rollup/plugin-replace": "^6.0.3",
    "@shikijs/markdown-exit": "^4.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/less": "^3.0.8",
    "@types/node": "^26.6.6",
    "@types/rtlcss": "^3.5.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.5",
    "eslint-plugin-oxlint": "~1.95.0",
    "eslint-plugin-vue": "~10.12.1",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.95.0",
    "prettier": "3.10.1",
    "rollup": "^4.68.5",
    "rtlcss": "^4.3.0",
    "shiki": "^4.5.0",
    "start-server-and-test": "^3.0.13",
    "svgo": "^4.1.0",
    "typescript": "~7.0.2",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
